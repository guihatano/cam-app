# URL RTSP da câmera
# Formato: rtsp://USUARIO:SENHA@IP_DA_CAMERA:554/
#
# Exemplos comuns para câmeras XM/iCSee:
#   rtsp://admin:SUA_SENHA@192.168.1.100:554/
#   rtsp://admin:SUA_SENHA@192.168.1.100:554/user=admin&password=SUA_SENHA&channel=1&stream=0.sdp
#   rtsp://admin:SUA_SENHA@192.168.1.100:554/h264/ch1/main/av_stream
#
# Para descobrir o IP da câmera: use o app iCSee > Configurações > Info do Dispositivo
# Ou escaneie a rede: nmap -sn 192.168.1.0/24

RTSP_URL=rtsp://admin:SUA_SENHA@192.168.1.100:554/

# Qualidade JPEG (1-100, padrão 80)
JPEG_QUALITY=80

# Porta do servidor web (padrão 5000)
PORT=5000
